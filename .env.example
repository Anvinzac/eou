# Client
VITE_API_URL=/api
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-hosted-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server (also loaded from root .env via dotenv)
PORT=3001
CLIENT_ORIGIN=http://localhost:8080
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-hosted-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Short links for shared quiz media: the public origin that serves /s/CODE and /og/*.
# Required in production for share links (exports fall back to the plain quiz URL without it);
# leave empty locally to use http://localhost:PORT.
SHARE_BASE_URL=""
# Public origin of the web app that short links redirect to (defaults to CLIENT_ORIGIN).
APP_PUBLIC_URL=""

# Qwen distractors (server-only — do not expose as VITE_*)
QWEN_API_KEY="your-qwen-api-key"
QWEN_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"
