VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-hosted-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Qwen (Qwen Cloud / DashScope) LLM for distractor generation
# Get a key from your Qwen Cloud / DashScope console.
VITE_QWEN_API_KEY="your-qwen-api-key"
# OpenAI-compatible base URL (default below is Alibaba DashScope).
VITE_QWEN_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# Model id (default qwen-plus).
VITE_QWEN_MODEL="qwen-plus"
